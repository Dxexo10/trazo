# Trazo API — variables de entorno de ejemplo.
# Copia este archivo como backend/.env y ajusta lo necesario.
# Nunca subas el .env real al repositorio.

NODE_ENV=development
PORT=4000

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Escrituras demo (crear/editar/archivar, alertas, reglas, reset y escenarios).
# En producción se desactivan por defecto; en local puedes habilitarlas:
# DEMO_WRITES_ENABLED=true

# La Fase 6 (Prisma + SQL Server) exigirá esta variable.
# DATABASE_URL="sqlserver://localhost:1433;database=Trazo;user=trazo_app;password=...;encrypt=true;trustServerCertificate=true"
