# Trazo — variables de entorno de ejemplo.
# Copia este archivo como .env y ajusta solo lo necesario.
#
# Frontend (F7): sin VITE_API_BASE_URL usa el repositorio mock sobre IndexedDB.
# Con ella, consume la API REST real. Se configura en frontend/.env
# (ver frontend/.env.example):
# VITE_API_BASE_URL=http://localhost:4000/api/v1
#
# El backend (F5–F7) usará SQL Server mediante Prisma. Estas variables viven en
# backend/.env, nunca en el frontend y nunca con valores reales en el repo:
# DATABASE_URL="sqlserver://localhost:1433;database=Trazo;user=trazo_app;password=...;encrypt=true;trustServerCertificate=true"
# PORT=4000
# CORS_ORIGINS=http://localhost:5173,https://tu-dominio.vercel.app
#
# En producción las escrituras se desactivan por defecto (demo de solo lectura).
# Para permitirlas explícitamente: DEMO_WRITES_ENABLED=true
# DEMO_WRITES_ENABLED=false
